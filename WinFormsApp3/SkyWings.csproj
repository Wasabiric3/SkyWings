<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<OutputType>WinExe</OutputType>
	<TargetFramework>net10.0-windows</TargetFramework>
	<Nullable>enable</Nullable>
	<UseWindowsForms>true</UseWindowsForms>
	<EnableDefaultApplicationDefinition>true</EnableDefaultApplicationDefinition>
	<ImplicitUsings>enable</ImplicitUsings>
	<AssemblyName>SkyWings</AssemblyName>
	<RootNamespace>SkyWings</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
	<PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />
	<!--
	  Keep this explicit reference. Microsoft.Data.Sqlite 9.0.0 pulls in e_sqlite3 2.1.10, which bundles a SQLite
	  with a known high-severity flaw (CVE-2025-6965, fixed in SQLite 3.50.2). This newer stable build replaces it.
	  Re-check with the "dotnet list package" command and its vulnerable option, including transitive packages.
	-->
	<PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.14" />
  </ItemGroup>

  <ItemGroup>
	<InternalsVisibleTo Include="SkyWings.Tests" />
  </ItemGroup>

  <ItemGroup>
	<!-- Brand images pre-rendered from the asset kit by tools/svg2png; loaded through UI/Assets.cs. -->
	<EmbeddedResource Include="Assets\*.png" LogicalName="Assets/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
